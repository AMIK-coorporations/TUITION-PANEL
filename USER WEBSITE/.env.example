# ============================================
# Environment template - copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# NOTE: Vite inlines every VITE_* variable into the shipped JavaScript bundle.
# They are visible to anyone who opens the site. Never put a secret here that
# must stay server-side.
# ============================================

# Your InsForge project URL (from the InsForge dashboard).
VITE_INSFORGE_URL=https://your-project.region.insforge.app

# Your InsForge anon/public key. This is safe to ship to a browser *only*
# because Row Level Security decides what it is allowed to read and write.
VITE_INSFORGE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# OPTIONAL - access codes
#
# These override the built-in obfuscated defaults (see src/lib/secrets.ts).
# Leave them unset to keep the defaults. Setting them here is no more secret
# than the source file - it is only more convenient to rotate.
# ---------------------------------------------------------------------------
# Code that unlocks the English language option.
# VITE_ENGLISH_ACCESS_CODE=

# Code that unlocks the Super Admin panel at /4321.
# VITE_ADMIN_ACCESS_CODE=